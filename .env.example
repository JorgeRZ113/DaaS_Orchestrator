# Application Configuration
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# API Authentication
API_KEY=changeme

# TNLCM (Trial Network Lifecycle Management) Configuration
TNLCM_URL=http://tnlcm.local:5000/
TNLCM_USER=changeme
TNLCM_PASSWORD=changeme
TNLCM_TOKEN=changeme

# ELCM (Experiment Lifecycle Management) Configuration
ELCM_URL=http://elcm.local:5001

# Request and Polling Configuration
REQUEST_TIMEOUT=60
POLL_INTERVAL=10
TNLCM_ACTIVATE_TIMEOUT=1800
TNLCM_ACTIVATE_RETRY_DELAY=5
TNLCM_ACTIVATE_REDEPLOY_MAX_ATTEMPTS=1
TNLCM_REDEPLOY_DELAY=5
TNLCM_RECOVERY_DESTROY_DELAY=0
TNLCM_REPORT_TIMEOUT=300

# File Paths and Logging
EXECUTIONS_FILE=./executions.json
ARTIFACTS_DIR=./artifacts
EXAMPLES_DIR=./examples
LOG_LEVEL=INFO
