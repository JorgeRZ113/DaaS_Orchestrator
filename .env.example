# Application Configuration
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# API Authentication
API_KEY=changeme

# TNLCM (Trial Network Lifecycle Management) Configuration
TNLCM_URL=http://tnlcm.local:5000/
TNLCM_USER=changeme
TNLCM_PASSWORD=changeme

# ELCM URL is resolved dynamically from TNLCM report summary

# File Paths and Logging
EXECUTIONS_FILE=./executions.json
ARTIFACTS_DIR=./artifacts
EXAMPLES_DIR=./examples
LOG_LEVEL=INFO
TELEMETRY_SNAPSHOT_ARTIFACTS=true
